# Lab-only placeholder credentials for infra/compose.yaml.
# Copy to infra/.env and change every value. Never commit a real .env.
KAFKA_ADMIN_PASSWORD=change-me-admin
KAFKA_VECTOR_PASSWORD=change-me-vector
KAFKA_INGEST_PASSWORD=change-me-ingest
KAFKA_KARAPACE_PASSWORD=change-me-karapace
VECTOR_WEBHOOK_TOKEN=change-me-webhook-token
VECTOR_REDTEAM_TOKEN=change-me-redteam-token

# Consumed by the ingest CLI (ingest run / check / emit).
INGEST_BOOTSTRAP=kafka:9092
INGEST_REGISTRY_URL=http://karapace:8081
INGEST_SASL_USERNAME=ingest
INGEST_SASL_PASSWORD=change-me-ingest
